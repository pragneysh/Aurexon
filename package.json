{
  "name": "aurexon-international-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.js",
    "test": "npm run test --workspace=@aurexon/backend",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:cloudfront": "node ./scripts/run-bash.js setup-cloudfront.sh",
    "deploy": "node ./scripts/run-bash.js deploy.sh",
    "deploy:aws": "node ./scripts/run-bash.js deploy.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.6"
  }
}
